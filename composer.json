{
    "name": "mago-assistant/magento2-higgsfield",
    "description": "Mago add-on: generate product images and videos with Higgsfield from the Magento admin chat",
    "type": "magento2-module",
    "keywords": [
        "magento2",
        "mago",
        "mago-addon",
        "higgsfield",
        "ai-images",
        "ai-video"
    ],
    "license": "MIT",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "guzzlehttp/guzzle": "^7.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-config": "*",
        "magento/module-store": "*",
        "mago-assistant/magento2-mago": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MagoAssistant\\Higgsfield\\": ""
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "MagoAssistant\\Higgsfield\\Test\\": "Test/"
        }
    }
}
