<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mago_higgsfield" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Higgsfield</label>
            <tab>mago_assistant</tab>
            <resource>MagoAssistant_Higgsfield::config</resource>
            <group id="connection" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Connection</label>
                <comment><![CDATA[Lets the assistant generate product images and videos with <a href="https://higgsfield.ai" target="_blank" rel="noopener">Higgsfield</a>. Every generation spends credits from the connected account and asks for confirmation first.]]></comment>
                <attribute type="expanded">1</attribute>
                <field id="status" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Higgsfield Account</label>
                    <frontend_model>MagoAssistant\Higgsfield\Block\Adminhtml\System\Config\Connection</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
